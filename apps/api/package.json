{
  "name": "@licensione/api",
  "version": "0.1.0",
  "private": true,
  "description": "Licensione license server — Cloudflare Worker (Hono + D1).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "start": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply licensione-db --local",
    "db:migrate": "wrangler d1 migrations apply licensione-db --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.2",
    "@licensione/shared": "*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.15",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20241218.0",
    "drizzle-kit": "^0.30.1",
    "vitest": "~4.1.9",
    "wrangler": "3.114.17"
  }
}
